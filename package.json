{
  "name": "webfont",
  "private": true,
  "version": "1.14.0",
  "type": "module",
  "scripts": {
    "dev": "pnpx tsx scripts/dev-all.ts",
    "dev:frontend": "vite",
    "dev:backend": "pnpx tsx backend/app.ts",
    "dev:backend:llrt": "pnpm build_backend && ./llrt ./dist_backend/app.cjs",
    "serve:llrt": "./llrt ./dist_backend/app.cjs",
    "build": "vite-ssg build",
    "build_backend": "pnpx tsx scripts/build-backend.ts",
    "lint:font-config": "pnpx tsx scripts/lint-font-config.ts",
    "docker_build": "docker build -t llej0/web-font:${npm_package_version} -t llej0/web-font:latest .",
    "docker_push": "docker push llej0/web-font:${npm_package_version} && docker push llej0/web-font:latest",
    "preview": "vite preview",
    "release": "pnpm build && pnpm build_backend && pnpm docker_build && pnpm docker_push"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.3",
    "pinyin-pro": "^3.29.5",
    "web-streams-polyfill": "^4.3.0",
    "webfont-sdk": "workspace:*"
  },
  "devDependencies": {
    "@leafer-ui/node": "2.2.9",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@xmldom/xmldom": "^0.9.12",
    "jsdom": "^30.1.3",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.16.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "undici": "^8.12.3",
    "vite": "^8.3.5",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-pilot": "^1.0.36",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.5",
    "vue": "3.6.0-beta.17",
    "vue-router": "^5.4.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.13"
  }
}
